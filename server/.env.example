# Copy to server/.env and fill in for production (loaded by `npm start`).

# HTTP + WebSocket port the site listens on (put a TLS reverse proxy in front).
HTTP_PORT=8080

# --- Gateway mode: bridge browsers to your real IRCd ------------------------
# Setting IRC_UPSTREAM_HOST switches the server from bundled-ircd mode to
# gateway mode. Leave it unset for local development (bundled ircd).
IRC_UPSTREAM_HOST=irc.example.com
IRC_UPSTREAM_PORT=6697
IRC_UPSTREAM_TLS=1
# Set to 0 ONLY for a self-signed test cert (insecure).
IRC_UPSTREAM_TLS_REJECT_UNAUTHORIZED=1

# Server name used as the prefix of gateway-originated MEDIA messages.
IRC_SERVER_NAME=qchat.example.com

# --- WEBIRC (recommended) ---------------------------------------------------
# Makes the IRCd see each user's REAL IP instead of the gateway's shared IP,
# and avoids per-IP connection limits. Must match a webirc block on the IRCd
# whose mask is THIS server's public IP. Leave WEBIRC_PASSWORD empty to disable.
WEBIRC_PASSWORD=
WEBIRC_NAME=qchat

# --- Identity bridge for the PHP website ------------------------------------
# Lets the PHP site sign up / verify logins / reset passwords via NickServ
# through this gateway. Enabled only when BOT_ACCOUNT + BOT_PASSWORD are set.
#  - BOT_ACCOUNT / BOT_PASSWORD: a registered Services-admin account (see the
#    "QBot" oper block). Needed only for password resets (SASET).
#  - INTERNAL_API_SECRET: a long random string; the PHP site sends it in the
#    X-Internal-Secret header. The /internal/* endpoints reject anything else.
BOT_ACCOUNT=QBot
BOT_PASSWORD=
INTERNAL_API_SECRET=
# Channels QBot joins and stays in, so it is always shown in the userlist.
# MUST be quoted: the leading '#' is otherwise read as a comment and dropped.
BOT_CHANNELS="#General"
