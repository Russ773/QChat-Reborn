# QChat Reborn behind Caddy (the simplest option: it gets and renews the HTTPS certificate
# by itself, and handles the chat WebSocket without extra settings).
# Save as /etc/caddy/Caddyfile and run `systemctl reload caddy`.

qchat.co.uk, www.qchat.co.uk {
	encode gzip
	reverse_proxy 127.0.0.1:8300 {
		# Overwrite, never append, the visitor address.
		header_up X-Forwarded-For {remote_host}
	}
}
