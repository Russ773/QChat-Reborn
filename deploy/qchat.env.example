# QChat Reborn settings. The installer copies this to /etc/qchat/qchat.env the first time.
# After editing, apply with:  sudo systemctl restart qchat

NODE_ENV=production

# The app listens on this port, on this machine only. Your web server passes visitors to it.
HTTP_PORT=8300

# These accounts are always administrators. Register this name FIRST, with a strong password.
ADMIN_ACCOUNTS=Russ

# The app sits behind your web server, so trust the visitor address it passes along.
# Only keep this on if the app is NOT reachable directly from the internet.
TRUST_PROXY=1

# Websites allowed to open the chat connection from a browser.
ALLOWED_ORIGINS=https://qchat.co.uk,https://www.qchat.co.uk

# Days a login can sit unused before it lapses.
SESSION_IDLE_DAYS=30
