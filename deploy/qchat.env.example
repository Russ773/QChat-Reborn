# QChat Reborn settings. The installer copies this to /etc/qchat/qchat.env the first time.
# After editing, apply with:  sudo systemctl restart qchat

NODE_ENV=production

# The app listens on this port, on this machine only. Your web server passes visitors to it.
HTTP_PORT=8300

# These accounts are always administrators. Register this name FIRST, with a strong password.
ADMIN_ACCOUNTS=Russ

# The app sits behind your web server, so trust the visitor address it passes along.
# Only keep this on if the app is NOT reachable directly from the internet.
TRUST_PROXY=1

# Websites allowed to open the chat connection from a browser.
ALLOWED_ORIGINS=https://qchat.co.uk,https://www.qchat.co.uk

# Days a login can sit unused before it lapses.
SESSION_IDLE_DAYS=30

# Email (confirming an address, forgotten passwords). Leave these out and the email features stay hidden.
# QChat hands each message to the mail server on this machine (no login). It limits itself to
# 5 emails a minute and 200 a day, and 3 an hour and 10 a day to any one address, to protect the server's reputation
# (raise the daily number gradually once the first weeks look clean). After 3 failures in a row it pauses 15 minutes.
#MAIL_TRANSPORT=smtp
#SMTP_HOST=127.0.0.1
#SMTP_PORT=25
#MAIL_FROM=QChat <noreply@qchat.co.uk>
#MAIL_REPLY_TO=contact@qchat.co.uk
#QCHAT_PUBLIC_URL=https://qchat.co.uk

# Live video (an administrator also has to switch it on in the admin area).
# The connection servers browsers use to find each other. The default is Cloudflare's public one.
#QCHAT_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"}]
# Hours an account must be old before it can use a camera (it can always watch).
#QCHAT_CAM_MIN_AGE_HOURS=24
