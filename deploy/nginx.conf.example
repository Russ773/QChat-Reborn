# QChat Reborn behind nginx. Save as /etc/nginx/sites-available/qchat (then link it into
# sites-enabled), run `sudo certbot --nginx -d qchat.co.uk -d www.qchat.co.uk` for the
# certificate, then `nginx -t && systemctl reload nginx`.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name qchat.co.uk www.qchat.co.uk;
    return 301 https://qchat.co.uk$request_uri;
}

server {
    listen 443 ssl http2;
    server_name qchat.co.uk www.qchat.co.uk;

    # certbot fills these in for you
    ssl_certificate     /etc/letsencrypt/live/qchat.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qchat.co.uk/privkey.pem;

    # Pictures are limited to 3 MB by the app; leave a little room for the request itself.
    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:8300;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        # OVERWRITE the visitor address (do not use $proxy_add_x_forwarded_for).
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The live chat connection
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
